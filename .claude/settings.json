{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/review_gate.py\" hook",
            "timeout": 20,
            "statusMessage": "Checking commit review gate"
          }
        ]
      }
    ]
  }
}
